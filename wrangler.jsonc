// Cloudflare Workers config: a small Worker (worker/index.ts) handles /api/message and
// Build Share (/api/builds, /i/<id>), and serves the static site built into `out/` for everything else.
{
  "name": "portfolio-0206",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Browser page visits to these paths must reach the Worker, not the 404 page.
    "run_worker_first": ["/api/*", "/i/*"]
  },
  // Build Share: test APKs are stored in this R2 bucket (create it first in the dashboard).
  "r2_buckets": [{ "binding": "BUILDS", "bucket_name": "app-builds" }],
  // Per-visitor rate limits (requests per 60 seconds, counted per IP address).
  "ratelimits": [
    { "name": "RL_CHAT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_BUILDS", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_OWNER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Daily clean-up of expired builds.
  "triggers": { "crons": ["17 3 * * *"] }
}
